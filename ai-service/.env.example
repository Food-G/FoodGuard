# DB 연결 (기본값은 config.py 참고)
DB_URL=mysql+pymysql://root:password@localhost:3306/foodguard
DB_SSL=true

# 기상청 공공데이터포털 API 키
# 발급: https://www.data.go.kr -> "기상청_단기예보_조회서비스" 신청
KMA_API_KEY=

# Spring ↔ ai-service 공유 비밀 (B-1). 비어 있으면 개발 모드로 인증 없이 통과
INTERNAL_API_TOKEN=
# 브라우저 직접 호출 허용 출처 (쉼표 구분)
CORS_ORIGINS=http://localhost:5173
