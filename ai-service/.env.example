# DB 연결 (기본값은 config.py 참고)
DB_URL=mysql+pymysql://root:password@localhost:3306/foodguard
DB_SSL=true

# 기상청 공공데이터포털 API 키
# 발급: https://www.data.go.kr -> "기상청_단기예보_조회서비스" 신청
KMA_API_KEY=발급받은_서비스키

# 발주 근거 설명용 claude CLI (Windows 는 claude.cmd 대신 claude.exe 경로, 로그인된 Claude Code 필요)
# CLAUDE_CLI=C:\Users\<사용자>\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe
