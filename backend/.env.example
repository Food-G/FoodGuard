# backend/.env 로 복사해 실제 값을 채운다 (.env 는 gitignore). 값은 절대 커밋하지 않는다.
DB_URL=jdbc:mysql://<host>:4000/foodguard?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3
DB_USERNAME=
DB_PASSWORD=
# 32바이트 이상 랜덤 (예: python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=
AI_SERVICE_URL=http://localhost:8000
# ai-service/.env 의 INTERNAL_API_TOKEN 과 같은 값
INTERNAL_API_TOKEN=
