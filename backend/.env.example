# backend/.env 로 복사해 실제 값을 채운다 (.env는 커밋 금지)
# application.properties의 spring.config.import가 이 파일을 읽는다
DB_PASSWORD=TiDB_Cloud_비밀번호
JWT_SECRET=32자_이상의_임의_문자열
# AI 서비스와 같은 값 (ai-service/.env 의 INTERNAL_API_KEY). 비우면 보내지 않는 것과 같다 (로컬 개발용), 운영은 필수
# AI_INTERNAL_KEY=32자_이상의_임의_문자열
# 운영(prod 프로필)에서만: 프론트 도메인
# APP_CORS_ALLOWED_ORIGINS=https://example.com
