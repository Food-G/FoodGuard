# .env.prod 로 복사해 채운다 (커밋 금지). docker compose --env-file .env.prod up -d --build

DOMAIN=foodguard.example.com

# TiDB 비밀번호
DB_PASSWORD=
# AI 서비스용 접속 주소. 비밀번호에 특수문자가 있으면 URL 인코딩 (@ → %40)
AI_DB_URL=mysql+pymysql://사용자:비밀번호@호스트:4000/foodguard

# python -c "import secrets; print(secrets.token_urlsafe(48))" 로 각각 새로 만든다
JWT_SECRET=
AI_INTERNAL_KEY=

# 기상청 공공데이터 API 키 (없으면 날씨 없이 예측)
KMA_API_KEY=
